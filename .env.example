# Environment variables for ProteinCraft
# Copy this file to .env and fill in your values

# ── Application ──────────────────────────────────────────────────
APP_NAME=ProteinCraft
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# ── Database ─────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://proteincraft:proteincraft@postgres:5432/proteincraft

# ── AI / ML ──────────────────────────────────────────────────────
ESM_MODEL_NAME=facebook/esm2_t33_650M_UR50D
ESM_DEVICE=cpu   # set to "cuda" if GPU is available
HF_API_TOKEN=    # HuggingFace token for ESMFold Inference API (optional)

# ── Gemini ───────────────────────────────────────────────────────
GEMINI_API_KEY=AIzaSyDnG-3C0zL2JizWjZJobcvTLNKqY6wHYLs
GEMINI_MODEL=gemini-2.5-flash

# ── ESMFold ──────────────────────────────────────────────────────
ESMFOLD_API_URL=https://api.esmatlas.com/foldSequence/v1/pdb
ESMFOLD_TIMEOUT=120

# ── CORS ─────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
